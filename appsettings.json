{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ── Container SSH (Azure App Service / Kudu access) ──
  // Configured via environment variables, not appsettings, because sshd starts
  // in the entrypoint before the .NET host reads config:
  //   CRAFT_SSH_ENABLED=true     start sshd on port 2222 (default: false)
  //   CRAFT_SSH_PASSWORD=...     root password (default: "Docker!" — Azure standard)
  // The OpenSSH server is installed in the image but is NOT started unless
  // CRAFT_SSH_ENABLED=true. Required for Azure's "SSH", `az webapp ssh`, and
  // the Kudu console "SSH" link — those land in your app container only when
  // an sshd is listening on 2222.

  "App": {
    // Display name shown in logs and diagnostics
    "Name": "Craft",

    // ── Deployment roles (capabilities) ──
    // One image, three independent switches for split deployments. Leave all unset (the default) to run the
    // full monolith: Frontend + Http + Background. If you set ANY of the three, the host uses exactly those
    // (unset → off). Environment overrides (take precedence): CRAFT_SERVE_FRONTEND, CRAFT_SERVE_API,
    // CRAFT_RUN_BACKGROUND (each true/false).
    // Presets: frontend | http | background | backend (http+bg) | frontend+http | combined (default).
    // NOTE: a node that triggers orchestrations from HTTP must also carry Background (use "backend"/"combined").
    // "Roles": { "Frontend": true, "Http": true, "Background": false },

    // ── Health probe ──
    // Role-agnostic liveness/readiness endpoint. Enabled by default at /healthz. Relocate or disable it via
    // App:Health:Path / App:Health:Enabled, or the CRAFT_HEALTH_PATH / CRAFT_HEALTH_ENABLED env vars (win).
    // "Health": { "Enabled": true, "Path": "/healthz" },

    // Controls when Kestrel starts accepting connections:
    // "Immediate" — Kestrel starts first, init runs in background (default, fast startup)
    // "HttpReady" — Kestrel starts after HTTP worker pool is ready
    // "AllReady"  — Kestrel starts after all worker pools are fully initialized
    // "ReadinessMode": "Immediate",

    // Kestrel request timeout (seconds). Determines how long Kestrel waits for a complete
    // request before aborting. If not set (or 0), derives from Worker.HttpTimeoutSeconds
    // if > 0, else defaults to no timeout. Recommended: set slightly higher than HttpTimeoutSeconds
    // to give workers time to respond before Kestrel drops the connection.
    // "KestrelTimeoutSeconds": 130,

    // File-backed logging with rotation (all values below are defaults — no config needed)
    // "FileLogging": {
    //   "Directory": "",              // default: /logs (Linux) or {BaseDir}/logs (Windows)
    //   "FilePrefix": "craft",        // files: craft.log, craft.1.log, craft.2.log, ...
    //   "MaxFileSizeMB": 10,          // rotate when current file exceeds this size
    //   "MaxFileCount": 10,           // keep at most N rotated files (total: N+1 including current)
    //   "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
    //   "IncludeCategory": false,     // include logger category name in log lines
    //   "LogLevel": "Information"     // Trace|Debug|Information|Warning|Error|Critical
    //                                 // Also controls PS stream capture:
    //                                 //   Debug  → enables Write-Debug
    //                                 //   Trace  → enables Write-Debug + Write-Verbose
    //                                 // Override via CRAFT_LOG_LEVEL env var
    // },

    "Worker": {
      // Number of dedicated HTTP request workers (each handles one request at a time)
      "HttpPoolSize": 2,
      // Number of background workers for scheduler, orchestrator, and queue tasks
      "BgPoolSize": 4,

      // Run each worker's PowerShell pipeline on one reused thread instead of a new thread per invocation.
      // Default true — the biggest per-request dispatch win (~50% of PS-invoke cost; see
      // docs/dispatch-analysis.md). Set false only to A/B or if a module misbehaves on a long-lived thread.
      // "ReuseRunspaceThread": true,

      // Host-tier pool sizing. When set, the first matching entry overrides
      // HttpPoolSize/BgPoolSize above based on the runtime environment.
      //   SkuEnv: name of the env var to read for the host tier identifier
      //           (e.g. "WEBSITE_SKU" on Azure App Service). Omit or "" = wildcard.
      //   Sku:    expected value of that env var, compared case-insensitively
      //           (e.g. "Basic", "PremiumV3"). Ignored when SkuEnv is empty.
      //   Cpu:    compared to Environment.ProcessorCount (respects cgroup limits in
      //           Docker). Omit or 0 = match any CPU count.
      // First match wins. No match (or any parse failure) leaves the baseline above.
      // Set IgnoreSkuProfiles: true to disable this entirely.
      // "IgnoreSkuProfiles": false,
      // "SkuProfiles": [
      //   { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic",     "Cpu": 1, "HttpPoolSize": 2, "BgPoolSize": 2 },
      //   { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic",     "Cpu": 2, "HttpPoolSize": 3, "BgPoolSize": 4 },
      //   { "SkuEnv": "WEBSITE_SKU", "Sku": "Basic",     "Cpu": 4, "HttpPoolSize": 4, "BgPoolSize": 4 },
      //   { "SkuEnv": "WEBSITE_SKU", "Sku": "PremiumV3", "Cpu": 2, "HttpPoolSize": 4, "BgPoolSize": 8 },
      //   { "Cpu": 8,                                              "HttpPoolSize": 6, "BgPoolSize": 12 }
      // ],

      // Maximum execution time (seconds) for HTTP request handlers
      // When exceeded, the PowerShell pipeline is stopped and the worker is reclaimed
      // 0 = no timeout (default). Recommended: 120-300 for HTTP endpoints
      // "HttpTimeoutSeconds": 0,

      // Maximum execution time (seconds) for background jobs (scheduler, orchestrator tasks)
      // When exceeded, the PowerShell pipeline is stopped and the worker is reclaimed
      // 0 = no timeout (default). Recommended: 600-3600 for background jobs
      // "BgTimeoutSeconds": 0,

      // Extra env vars injected into every runspace
      // "EnvVars": { "MY_VAR": "value" },

      // Additional env var names set to the API root path (alongside $env:CRAFT_ROOT)
      // "RootPathVars": ["MyAppRoot"],

      // Scripts run once on first worker for warmup (after module import, errors non-fatal)
      // "WarmupScripts": ["Get-MyAuth | Out-Null"],

      // .NET assemblies loaded into each runspace (paths relative to API/)
      // "SharedAssemblies": ["Shared/MyLib.dll"],

      // Inject shared Synchronized Hashtables into module scopes for cross-runspace state
      // "ModuleInjections": [{ "Module": "MyModule", "Variable": "tokenCache", "CacheKey": "TokenCache" }],

      // Scripts run after init on EVERY worker (not just the first)
      // "PostInitScripts": [],

      // Module directory names to skip during import
      // "SkipModules": [],

      // JSON files preloaded into PowerShell variables at startup
      // "JsonPreloads": [{ "File": "Config/perms.json", "Variable": "Permissions", "Scope": "global", "AsHashtable": true }]
    },

    "Auth": {
      // Session cookie name
      "CookieName": "craft-session",
      // Azure Table for user → role mappings (UPN as RowKey, Roles as JSON array)
      "UserTableName": "allowedUsers"

      // Storage connection for the allowedUsers table (empty = use AzureWebJobsStorage)
      // "UserStorageConnection": "",

      // Roles for the auto-login dev principal (Development mode only, ignored in Production)
      // "DevRoles": ["admin", "authenticated", "anonymous"],

      // PowerShell function dispatched for /api/me (empty = literal "me")
      // "MeEndpointFunction": "",

      // Optional wrapper PS function for /api/me. When set, the wrapper is invoked
      // instead of MeEndpointFunction directly, and MeEndpointFunction is passed
      // in via Request.Params.CIPPEndpoint so the wrapper can dispatch internally.
      // Empty (default) = invoke MeEndpointFunction directly.
      // Example (CIPP): "New-CippCoreRequest"
      // "MeEndpointHandler": ""

      // ── Production auth is configured via environment variables or KV references: ──
      // WEBSITE_AUTH_CLIENT_ID           = Azure AD app registration client ID
      // AUTH_SECRET                      = Azure AD client secret
      // WEBSITE_AUTH_AAD_ALLOWED_TENANTS = Tenant ID (or "common" for multi-tenant)
    },

    // "Setup": {
    //   "Enabled": false,
    //   "BootstrapClientId": "1950a258-227b-4e31-a9cf-717495945fc2",
    //   "AuthAppDisplayName": "",
    //   // RedirectToLoginPage | AllowAnonymous | RejectWith401 | RejectWith404
    //   "UnauthenticatedClientAction": "RedirectToLoginPage",
    //   // Paths excluded from EasyAuth (e.g. webhooks): ["/api/Public*", "/.auth/*"]
    //   "ExcludedPaths": [],
    //   // Client app IDs allowed to call with access tokens (empty = no restriction)
    //   "AllowedApplications": [],
    //   // Extra allowed token audiences beyond "api://{appId}" (empty = only api://{appId})
    //   "AllowedAudiences": [],
    //   // Tenant IDs allowed to auth. Empty = setup tenant only (single-tenant issuer).
    //   // Multiple entries → issuer becomes "common" + WEBSITE_AUTH_AAD_ALLOWED_TENANTS is set.
    //   "AllowedTenants": [],
    //   // Store EasyAuth client secret in Key Vault instead of app settings.
    //   // "auto" = use site name as vault name. Or set explicit vault name.
    //   // Empty (default) = store secret directly in AUTH_SECRET app setting.
    //   "KeyVaultName": "",
    //   // Roles assigned to the bootstrap user seeded via /api/setup/seed-user.
    //   // Empty (default) = ["superadmin"]. Override to match the hosted app's role taxonomy.
    //   "FirstUserRoles": []
    // },

    "Scheduler": {
      // JSON file with task definitions (looked up in API/Config/ then API/)
      "ConfigFile": "SchedulerTasks.json",
      // How often (seconds) the scheduler checks for due tasks
      "CheckIntervalSeconds": 30,
      // When true, applies the configured timezone to ALL tasks (not just TZOffset=true ones)
      "ApplyTZOffset": false,
      // IANA or Windows timezone ID for timezone-aware cron evaluation.
      // Overridden by env var CraftTZ if set. Empty = UTC.
      // Examples: "America/New_York", "Europe/London"
      "Timezone": ""
    },

    "Orchestrator": {
      // Prefix for Azure Tables: {Prefix}Runs, {Prefix}Tasks, {Prefix}Results
      "TablePrefix": "Orchestrator",
      // Max task interruptions (crash/restart) before marking Failed
      "MaxRetries": 3,
      // Batch + coalesce per-task/run status writes off the fan-out critical path (results are never batched).
      // Default true. Removes the per-task Azure Table write that gates worker throughput — see
      // docs/orch-analysis.md. Set false for the original per-task writes.
      // "BatchStatusWrites": true,
      // Write the pre-invoke "Running" marker under a durable barrier (persisted before the task runs, so
      // AttemptCount/MaxRetries still bounds poison tasks). Default true. False = eventual (max throughput —
      // 100% pool utilization — but the marker rides the periodic flush; terminal/run states stay durable).
      // "DurableRunningBarrier": true,
      // Status writer flush interval / barrier latency ceiling (ms). Default 25.
      // "StatusFlushIntervalMs": 25
    },

    "Cache": {
      // Whether the in-memory/disk-backed API response cache is active. Omit (default) for auto: ON only
      // when this node serves BOTH a browser UI and its API (combined / frontend+http roles), OFF for
      // api-only, worker-only and static-only nodes. Set true/false to force it. Env override (wins):
      // CRAFT_RESPONSE_CACHE=true/false. When off, no _cache/ dir is created and get/set are no-ops.
      // "Enabled": true,

      // Bytes budget for keeping cached response bodies in memory (LRU tier over the disk cache) so a HIT
      // returns from RAM instead of re-reading the file. Default 64 MiB; 0 = disk-only. Big win for large
      // List* responses (+157% throughput at ~150KB — see docs/cache-analysis.md).
      // "MaxMemoryBytes": 67108864,

      // Maximum cached responses held in memory
      "MaxEntries": 1000,
      // Default TTL (seconds) for cached responses
      "DefaultTtlSeconds": 600

      // Query parameter that triggers cache invalidation when "true"
      // "InvalidateParam": "InvalidateCache",

      // Query parameter for scoped invalidation (e.g. per-tenant)
      // "ScopeParam": "",

      // Per-endpoint TTL overrides (seconds): { "ListUsers": 120 }
      // "EndpointTtl": {}
    },

    "Scripts": {
      // Module directories (under API/Modules/) scanned for HTTP endpoint functions
      // "HttpModules": [],

      // Optional global HTTP handler. When set, ALL /API/{endpoint} routes are dispatched
      // through this single PS function instead of invoking the route's function directly.
      // The endpoint name is passed via Request.Params.CIPPEndpoint so the handler can
      // dispatch internally. Use when the hosted app expects all routes to go through a
      // common router (e.g. CIPP's New-CippCoreRequest which does Test-CIPPAccess + telemetry).
      // Empty (default) = each /API/{endpoint} invokes Invoke-{endpoint} directly.
      // "HttpHandler": "New-CippCoreRequest",

      // Directories (under API/) scanned for background scripts
      // "BackgroundScriptDirs": [],

      // RBAC metadata extraction from .ROLE / .FUNCTIONALITY comment-based help
      "PermissionExtraction": {
        "Enabled": false
        // "Modules": [],
        // "OutputFile": "function-permissions.json"
      }
    }

    // Container health monitoring — detects crash loops and forces Azure to
    // provision a new worker by refusing to start Kestrel after repeated failures.
    // Tracker file is written to /home/craft/ (Azure Files persistent mount).
    // "ContainerHealth": {
    //   "MaxRestarts": 3,         // consecutive crashes before blocking startup (0 = disabled)
    //   "WindowMinutes": 30,      // only count restarts within this window
    //   "TrackerDirectory": ""    // default: /home/craft (Linux) or disabled (Windows/dev)
    // }

    // Frontend response policy. EasyAuth handles auth/redirects at the platform layer;
    // CRAFT only adds response headers EasyAuth doesn't touch.
    // "Frontend": {
    //   // Content-Security-Policy applied to all responses. Null/empty = no CSP.
    //   "ContentSecurityPolicy": "default-src https: blob: 'unsafe-eval' 'unsafe-inline'; object-src 'self' blob:; img-src 'self' blob: data: *",
    //   // Compress static responses. Default true: serve precompressed .br/.gz siblings + on-the-fly
    //   // fallback. Set false to serve everything raw/identity (no .br/.gz served, no on-the-fly) — e.g.
    //   // when an upstream CDN (Cloudflare) already compresses, the content doesn't benefit, or for
    //   // A/B measuring compressed vs raw. Env override: CRAFT_COMPRESSION=true|false (wins over this).
    //   "Compression": true
    // }
  }
}

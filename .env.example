# ─────────────────────────────────────────────────────────────
# Craft Environment Variables
# Copy this file to .env and fill in the values for your setup.
#
# Application settings (worker pool sizes, cache TTL, scheduler config, etc.)
# belong in appsettings.json — NOT here.
# See docs/configuration.md for the full settings reference.
# ─────────────────────────────────────────────────────────────

# ── Runtime ──
ASPNETCORE_ENVIRONMENT=Development
CRAFT_VERBOSE=false
# ShowDebug=false

# ── Azure Storage (required) ──
# Connection string for Azure Table/Blob/Queue storage.
# Use "UseDevelopmentStorage=true" for local Azurite.
# AzureWebJobsStorage=UseDevelopmentStorage=true

# ── Authentication (Azure AD / Entra ID) ──
# Required for production. In Azure App Service, use Key Vault references instead.
# See docs/configuration.md for KV reference syntax.
# WEBSITE_AUTH_CLIENT_ID=<app-registration-client-id>
# AUTH_SECRET=<app-registration-client-secret>
# WEBSITE_AUTH_AAD_ALLOWED_TENANTS=<tenant-id-or-common>

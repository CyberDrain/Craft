# ── Craft Release Image ────────────────────────────────────
# CyberDrain Runtime for Apps, Functions, Tasks
# Optimized Release build for production deployments.

# Default the .NET base images to the GHCR mirror (CyberDrain/Containers) so
# builds survive an mcr.microsoft.com / Azure Container Registry outage.
# Override with --build-arg DOTNET_REGISTRY=mcr.microsoft.com to pull upstream.
ARG DOTNET_REGISTRY=ghcr.io/cyberdrain

FROM ${DOTNET_REGISTRY}/dotnet/sdk:8.0-bookworm-slim AS build
WORKDIR /src

COPY Craft.csproj .
RUN dotnet restore

COPY . .
RUN dotnet publish -c Release -o /app/publish && \
    rm -rf /app/publish/ref \
           /app/publish/cs /app/publish/de /app/publish/es /app/publish/fr \
           /app/publish/it /app/publish/ja /app/publish/ko /app/publish/pl \
           /app/publish/pt-BR /app/publish/ru /app/publish/tr \
           /app/publish/zh-Hans /app/publish/zh-Hant

FROM ${DOTNET_REGISTRY}/dotnet/aspnet:8.0-bookworm-slim AS runtime
WORKDIR /app

# Copy PowerShell from the SDK build stage (PS is bundled in dotnet/sdk images)
COPY --from=build /usr/share/powershell /usr/share/powershell
RUN ln -s /usr/share/powershell/pwsh /usr/bin/pwsh

# Optional SSH server for Azure App Service SCM access. Installed unconditionally
# but NOT started — the entrypoint launches sshd only when CRAFT_SSH_ENABLED=true.
# Adds ~12MB to the image. Uses Azure's standard port 2222 and root login.
#
# Also installs libmimalloc — a drop-in malloc replacement that returns freed
# memory to the OS far more aggressively than glibc malloc. PowerShell runspaces
# allocate-and-free in patterns that glibc holds onto indefinitely (per-thread
# arenas + low trim threshold), causing RSS to climb well past the actual live
# working set. Preloading mimalloc typically reclaims 20–40% RSS on long-lived
# .NET-on-Linux hosts that spawn child processes. LD_PRELOAD propagates to
# child pwsh runspaces automatically, which is exactly what we want here.
# SSH (App Service SCM access) is gated behind INSTALL_SSH — default true for the dev/prod images;
# portable/off-Azure images build with --build-arg INSTALL_SSH=false to drop the daemon entirely.
# libmimalloc is always installed. SSH is still never started unless CRAFT_SSH_ENABLED=true at runtime.
ARG INSTALL_SSH=true
RUN apt-get update \
 && apt-get install -y --no-install-recommends libmimalloc2.0 \
 && if [ "$INSTALL_SSH" = "true" ]; then \
      apt-get install -y --no-install-recommends openssh-server && mkdir -p /run/sshd; \
    fi \
 && rm -rf /var/lib/apt/lists/*
COPY docker/sshd_config /etc/ssh/sshd_config
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

COPY --from=build /app/publish .

# ─── Runtime Configuration ────────────────────────────────
ARG APP_VERSION=0.0.0-local
ARG COMMIT_SHA=unknown
ARG IMAGE_TAG=latest
ENV APP_VERSION=$APP_VERSION
ENV COMMIT_SHA=$COMMIT_SHA
ENV IMAGE_TAG=$IMAGE_TAG

ENV CRAFT_VERBOSE="false"
# SSH is opt-in. Set CRAFT_SSH_ENABLED=true at runtime to start sshd on port 2222.
ENV CRAFT_SSH_ENABLED="false"

# ── Memory & runtime tuning ──
# mimalloc preload — see install step above for rationale.
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libmimalloc.so.2
# Cap glibc per-thread arenas. Even with mimalloc preloaded, anything that
# bypasses LD_PRELOAD (vDSO, some syscalls, statically-linked helpers) still
# uses glibc; capping arenas to 2 prevents fragmentation when that happens.
ENV MALLOC_ARENA_MAX=2
# Suppress PowerShell + .NET CLI background work in every runspace.
ENV POWERSHELL_TELEMETRY_OPTOUT=1
ENV POWERSHELL_UPDATECHECK=Off
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

# ── .NET GC tuning ──
# Workstation GC by default: on memory-constrained tiers (Basic B2, 2 vCPU/3.5 GB)
# it ~halves peak RSS vs server GC at no throughput cost. Override to
# DOTNET_gcServer=1 (App Setting, no rebuild) on multi-core SKUs, where DATAS
# below keeps server GC's per-core heaps from over-reserving.
ENV DOTNET_gcServer=0
ENV DOTNET_GCDynamicAdaptationMode=1
# Absolute managed-heap cap in bytes (HEX): 0x80000000 = 2 GiB. Absolute, not
# percent, so packing multiple instances into one App Service Plan is safe — a
# percent limit sizes off the whole shared VM. Tune per deployment via App Setting.
ENV DOTNET_GCHeapHardLimit=0x80000000
# 0–9 scale; higher = more aggressive about returning freed segments to the OS
# rather than caching them for reuse. Pairs with the mimalloc preload above —
# the runtime hands pages back to mimalloc, which hands them back to the kernel.
ENV DOTNET_GCConserveMemory=7

EXPOSE 8080 2222
ENV ASPNETCORE_URLS=http://+:8080

ENTRYPOINT ["/entrypoint.sh"]

<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion / Nullable / ImplicitUsings / analyzer settings live in Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Craft.Configuration</RootNamespace>
    <Description>Craft settings POCOs — dependency leaf for the modular monolith.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <!-- ResolvedDirectory / ParsedLogLevel are used by the host FileLoggerProvider. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Craft" />
    <InternalsVisibleTo Include="Craft.Tests" />
  </ItemGroup>

</Project>

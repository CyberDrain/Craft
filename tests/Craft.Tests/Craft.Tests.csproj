<Project Sdk="Microsoft.NET.Sdk">

  <!-- LangVersion / Nullable / ImplicitUsings / analyzer settings come from Directory.Build.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Kept current for CVE hygiene: the 17.8.0 test SDK and xunit 2.5.3 dragged in System.Net.Http 4.3.0
    and System.Text.RegularExpressions 4.3.0, both with High-severity advisories. These never reached
    the runtime image (see the publish step in build/Dockerfile) but they do show up in an SBOM of the
    solution, and there is no reason to carry known-vulnerable packages in the test rig.
  -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Craft gets this from the ASP.NET shared framework; this plain-SDK project resolves Microsoft.PowerShell.SDK's
         10.0.10 instead, which GHSA-7hqp-7c5m-4vq6 / GHSA-c399-9853-6jmj / GHSA-r955-8q5j-3h83 cover up to 10.0.12. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Craft.csproj" />
  </ItemGroup>

  <!--
    The annotated config reference is read by ConfigurationReferenceTests, which asserts every default
    documented in it still matches the C# property default. Copied rather than embedded so a failure
    points the reader at the real file they are expected to edit.
  -->
  <ItemGroup>
    <None Include="..\..\appsettings.example.jsonc" CopyToOutputDirectory="PreserveNewest" Link="appsettings.example.jsonc" />
  </ItemGroup>

  <!--
    Endpoint sources, read by EndpointShapeTests. The shape it checks (an expression-bodied
    `async (HttpContext c) => Results.Json(...)`, which silently binds MapGet's RequestDelegate
    overload and discards the result) compiles cleanly and has no runtime signature to assert on
    without standing up a server, so the source itself is the thing under test.
  -->
  <ItemGroup>
    <None Include="..\..\Services\Hosting\Endpoints\*.cs" CopyToOutputDirectory="PreserveNewest" LinkBase="EndpointSources" />
  </ItemGroup>

  <!--
    PowerShell modules laid out exactly where the pool looks for them (<base>/API/Modules/<Name>/<Name>.psd1).
    WorkerModuleSharingTests warms a real pool against them: CraftPoolFixture is shared from one parse,
    CraftPoolNested (NestedModules) is imported per worker through the InitialSessionState.
  -->
  <ItemGroup>
    <None Include="TestApi\Modules\CraftPoolFixture\CraftPoolFixture.psd1" CopyToOutputDirectory="PreserveNewest" Link="API\Modules\CraftPoolFixture\CraftPoolFixture.psd1" />
    <None Include="TestApi\Modules\CraftPoolFixture\CraftPoolFixture.psm1" CopyToOutputDirectory="PreserveNewest" Link="API\Modules\CraftPoolFixture\CraftPoolFixture.psm1" />
    <None Include="TestApi\Modules\CraftPoolNested\CraftPoolNested.psd1" CopyToOutputDirectory="PreserveNewest" Link="API\Modules\CraftPoolNested\CraftPoolNested.psd1" />
    <None Include="TestApi\Modules\CraftPoolNested\CraftPoolNested.psm1" CopyToOutputDirectory="PreserveNewest" Link="API\Modules\CraftPoolNested\CraftPoolNested.psm1" />
    <None Include="TestApi\Modules\CraftPoolNested\CraftPoolNestedInner.psm1" CopyToOutputDirectory="PreserveNewest" Link="API\Modules\CraftPoolNested\CraftPoolNestedInner.psm1" />
  </ItemGroup>

</Project>
